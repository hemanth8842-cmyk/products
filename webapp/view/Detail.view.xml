<mvc:View
    controllerName="products.controller.Detail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page
        title="Product Details"
        showNavButton="true"
        navButtonPress="onBack">

        <content>

            <HBox
                width="100%"
                justifyContent="Start"
                alignItems="Start"
                class="sapUiLargeMargin">

                <!-- LEFT SIDE IMAGE -->
                <VBox
                    width="35%"
                    alignItems="Center"
                    class="sapUiMediumMarginEnd">

                    <Image
                        src="{
                            path:'ProductID',
                            formatter: '.getProductImage'
                        }"
                        width="320px"
                        height="320px"
                        densityAware="false" />

                </VBox>

                <!-- RIGHT SIDE DETAILS -->
                <VBox width="60%">

                    <!-- PRODUCT HEADER -->
                    <ObjectHeader
                        title="{ProductName}"
                        number="{UnitPrice}"
                        numberUnit="$"
                        intro="Product Overview"
                        class="sapUiSmallMarginBottom" />

                    <!-- DETAILS CARD -->
                    <VBox class="sapUiSmallMarginTop">

                        <ObjectStatus
                            title="Product ID"
                            text="{ProductID}" />

                        <ObjectStatus
                            title="Category ID"
                            text="{CategoryID}" />

                        <ObjectStatus
                            title="Supplier ID"
                            text="{SupplierID}" />

                        <ObjectStatus
                            title="Quantity Per Unit"
                            text="{QuantityPerUnit}" />

                        <ObjectStatus
                            title="Units In Stock"
                            text="{UnitsInStock}"
                            state="Success" />

                        <ObjectStatus
                            title="Units On Order"
                            text="{UnitsOnOrder}"
                            state="Warning" />

                        <ObjectStatus
                            title="Reorder Level"
                            text="{ReorderLevel}"
                            state="Error" />

                        <ObjectStatus
                            title="Discontinued"
                            text="{Discontinued}" />

                    </VBox>

                </VBox>

            </HBox>

        </content>

    </Page>

</mvc:View>